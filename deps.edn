{:paths ["src" "resources"]
 :deps {
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        ;; ongaku craft lib (ADR-2607023000) — BGM 選定 + ライセンスポリシー gate。
        ;; この repo は private カタログ実体（DOVA/incompetech 由来 asset 台帳と
        ;; チャンネル roster）だけを持つ。
        io.github.kotoba-lang/ongaku {:git/url "https://github.com/kotoba-lang/ongaku"
                                      :git/sha "117b4fe178ec4dfda55ea7de18a3fc4cd95a899d"}
        io.github.kotoba-lang/org-oasis-open-xmile
        {:git/url "https://github.com/kotoba-lang/org-oasis-open-xmile"
         :git/sha "9a703008784b2c46d2f7289d78438c450b47d906"}}
 :aliases
 {;; Workspace development — use the local lib checkout (no git fetch).
  :dev
  {:override-deps
   {io.github.kotoba-lang/ongaku {:local/root "../../kotoba-lang/ongaku"}}}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :world-compose
  {:main-opts ["-m" "ongakuka.actor"]}
  :xmile-conformance
  {:main-opts ["-m" "ongakuka.xmile-conformance"]}
  ;; Co-scientist runner (scripts/coscientist_murakumo.clj.cljk) — needs local ongaku.
  :cosci
  {:extra-paths ["scripts" "../../kotoba-lang/ongaku/src"]
   :extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
   :main-opts ["-m" "coscientist-murakumo"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "resources" "test"
                     "--fail-level" "error"]}}}
