{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        ;; ongaku craft lib (ADR-2607023000) — BGM 選定 + ライセンスポリシー gate。
        ;; この repo は private カタログ実体（DOVA/incompetech 由来 asset 台帳と
        ;; チャンネル roster）だけを持つ。
        io.github.kotoba-lang/ongaku {:git/url "https://github.com/kotoba-lang/ongaku"
                                      :git/sha "117b4fe178ec4dfda55ea7de18a3fc4cd95a899d"}
        io.github.kotoba-lang/org-oasis-open-xmile
        {:git/url "https://github.com/kotoba-lang/org-oasis-open-xmile"
         :git/sha "9a703008784b2c46d2f7289d78438c450b47d906"}}
 :aliases
 {;; Workspace development — use the local lib checkout (no git fetch).
  :dev
  {:override-deps
   {io.github.kotoba-lang/ongaku {:local/root "../../kotoba-lang/ongaku"}}}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :world-compose
  {:main-opts ["-m" "ongakuka.actor"]}
  :xmile-conformance
  {:main-opts ["-m" "ongakuka.xmile-conformance"]}
  ;; Co-scientist runner (scripts/coscientist_murakumo.clj) — needs local ongaku.
  :cosci
  {:extra-paths ["scripts" "../../kotoba-lang/ongaku/src"]
   :extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
   :main-opts ["-m" "coscientist-murakumo"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "resources" "test"
                     "--fail-level" "error"]}}}
