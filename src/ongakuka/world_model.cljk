(ns ongakuka.world-model
  "Loads and executes the OASIS XMILE model used by the composer actor.

  ## Why this is `.cljc` and not `.clj`

  Two lines made this namespace — and through it `ongakuka.actor`, the
  deterministic composer this repo exists for — JVM-only:
  `(io/resource ...)` and `Double/parseDouble`. The runtime order in this
  workspace is kotoba-wasm → clojurewasm → ClojureScript → nbb, with the JVM
  last, and a pure simulation over a 4 KB model has no business pinning a
  consumer to it.

  ## The model is compiled in ALREADY PARSED

  Not the XML text — the parsed document tree, generated by
  `tools/gen_embedded.cljk`. Embedding the text would not have been enough:
  `xmile.xml/parse-xml-string` does have a `:cljs` branch, but that branch
  calls `js/DOMParser`, a BROWSER API that does not exist under nbb or node
  (measured 2026-08-18: `(exists? js/DOMParser)` is false). Carrying XML we
  could never parse would be a reader conditional whose `:cljs` half nothing
  in this runtime can evaluate — the appearance of portability.

  Everything else upstream is already clean: `xmile.execute`, `xmile.validate`,
  `xmile.expr` and `xmile.model` branch only on `Math`. Once the parse is
  gone the whole simulation runs anywhere.

  The `.xmile` file stays the thing a human edits; `ongakuka.embedded` is a
  projection of it; `kbb -M tools/gen_embedded.cljk --check` refuses to let
  them drift. There is no runtime read, so there is no read that can fail and
  no `readable?`-style guard — such a check could only ever answer true."
  (:require [kotoba.lang.coll :as set]
            [kotoba.lang.text :as str]
            [ongakuka.embedded :as embedded]
            [xmile.execute :as execute]
            [xmile.validate :as validate]))

(def default-resource "models/cinematic-game-composer.xmile")

(def required-stocks
  #{"Theme_Coherence" "Orchestral_Narrative" "Melodic_Memorability"
    "Harmonic_Tension" "Loop_Durability"})

(def required-flows
  #{"Theme_Development" "Motif_Fatigue" "Orchestral_Build" "Density_Cost"
    "Melody_Clarification" "Melody_Saturation" "Tension_Build" "Resolution"
    "Loop_Learning" "Loop_Wear"})

(defn- eqn-number
  "The equation of `variable` as a number, or nil when it is not one.

  `parse-double` replaces `Double/parseDouble` in a try/catch: it is in both
  `clojure.core` and `cljs.core`, and it ANSWERS nil rather than throwing,
  so the nil that meant \"this aux is a formula, not a constant\" still means
  exactly that. It is slightly stricter than `Double/parseDouble` — no
  trailing `d`, no hex float literals — which is a narrowing of what counts
  as a parameter. `xmile-model-is-structurally-valid` pins the parameters
  this model actually yields, so the narrowing is measured rather than
  assumed."
  [variable]
  (parse-double (:xmile/eqn variable)))

(defn- by-kind [variables kind]
  (into {} (filter (fn [[_ v]] (= kind (:xmile/kind v)))) variables))

(defn model-from-document
  "Build the runtime model map from an already-parsed XMILE document.

  The injection point that replaced `load-model`'s resource-name argument.
  A caller with its own model supplies the parsed document here; nothing in
  this namespace reads a file.

  `nil` in, `nil` out. Every `get` on nil is nil and `(into {} (filter …) nil)`
  is `{}`, so a nil document would otherwise build a COMPLETE-LOOKING model
  with an empty `:xmile/stocks`, an empty `:xmile/flows` and no parameters —
  and `problems` would then report it as a model that is missing its stocks,
  which is a different and much more misleading finding than \"you passed
  nothing\"."
  [document]
  (when (some? document)
    (let [raw-model (first (:xmile/models document))
          runtime-model (assoc raw-model :xmile/sim-specs (:xmile/sim-specs document))
          variables (:xmile/variables raw-model)
          stocks (by-kind variables :stock)
          flows (by-kind variables :flow)
          auxes (by-kind variables :aux)]
      {:xmile/document document
       :xmile/version "1.0"
       :xmile/name (get-in document [:xmile/header :xmile/name])
       :xmile/model-name (:xmile/name raw-model)
       :xmile/sim {:start (get-in document [:xmile/sim-specs :xmile/start])
                   :stop (get-in document [:xmile/sim-specs :xmile/stop])
                   :dt (get-in document [:xmile/sim-specs :xmile/dt])
                   :method (get-in document [:xmile/sim-specs :xmile/method])}
       :xmile/stocks (into {} (map (fn [[n v]] [n (eqn-number v)]) stocks))
       :xmile/flows (set (keys flows))
       :xmile/parameters (into {} (keep (fn [[n v]]
                                          (when-let [x (eqn-number v)] [n x]))) auxes)
       :xmile/runtime-model runtime-model})))

(defn load-model
  "The composer's XMILE model, from the compiled-in parsed document.

  ## The resource-name argument is gone

  It used to take one, and `(load-model \"other.xmile\")` was the only way to
  point this at a different model. Nothing in this repo ever passed one, and
  the arity cannot survive without the runtime `io/resource` it existed to
  perform. A caller wanting a different model supplies its parsed document to
  `model-from-document` instead — strictly more capable, since that document
  need never have been a file."
  ([] (model-from-document embedded/document)))

(defn problems [model]
  (let [stocks (set (keys (:xmile/stocks model)))
        flows (:xmile/flows model)
        standard (validate/validate-doc (:xmile/document model))]
    (cond-> (vec standard)
      (seq (set/difference required-stocks stocks))
      (conj {:problem/type :ongakuka/missing-stocks
             :problem/names (set/difference required-stocks stocks)})
      (seq (set/difference required-flows flows))
      (conj {:problem/type :ongakuka/missing-flows
             :problem/names (set/difference required-flows flows)})
      (not= 1.0 (get-in model [:xmile/parameters "originality_guard"]))
      (conj {:problem/type :ongakuka/originality-guard-disabled}))))

(defn valid? [model] (empty? (problems model)))

(defn- clamp [x] (max 0.0 (min 1.0 x)))

(def signal-keys [:story-pressure :intimacy :wonder :darkness :loop-need])

(defn normalize-signals [brief]
  (into {} (for [k signal-keys] [k (clamp (double (get brief k 0.5)))])))

(defn- signal-variable-name [k] (str/replace (name k) "-" "_"))

(defn- inject-signals [runtime-model signals]
  (reduce-kv (fn [model k value]
               (assoc-in model [:xmile/variables (signal-variable-name k) :xmile/eqn]
                         (str value)))
             runtime-model signals))

(defn simulate
  "Runs the parsed XMILE model through kotoba-lang/org-oasis-open-xmile."
  [model brief]
  (let [issues (problems model)]
    (when (seq issues)
      (throw (ex-info "Invalid composer XMILE model" {:problems issues})))
    (let [signals (normalize-signals brief)
          runtime (inject-signals (:xmile/runtime-model model) signals)
          result (execute/run runtime)
          times (:xmile/times result)
          series (:xmile/series result)]
      (mapv (fn [i time]
              {:time time
               :stocks (into {} (map (fn [stock]
                                       [stock (get-in series [stock i])])
                                     required-stocks))})
            (range (count times)) times))))
